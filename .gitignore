# --- Secrets & Environment ---
.env
*.env
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
ENV/
.env/
.venv*/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/

# Type checkers & linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
*.cover
coverage.xml
nosetests.xml
test-results/

# --- Logs & Runtime Artifacts ---
*.log
*.txt.bak
hardening_out.txt
hardening_results.txt
submission_gen_log.txt
submission_gen_log2.txt
submission_progress.json

# --- IDE & Editor ---
.vscode/
.idea/
*.suo
*.user
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Node.js (leftover) ---
node_modules/
package-lock.json
npm-debug.log*

# --- Jupyter Notebooks ---
.ipynb_checkpoints/

# --- OS ---
Desktop.ini
ehthumbs.db
